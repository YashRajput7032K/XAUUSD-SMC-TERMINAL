# ─── XAUUSD SMC Analyzer — Environment Variables ─────────────────────────
# Copy this file to .env.local and fill in your API keys.
#
# Without any API key, the app runs in DEMO mode with synthetic data.
# The chart will clearly show "DEMO" status — no fake data is passed off as real.

# ─── Market Data Provider (choose one or both) ──────────────────────────

# Twelve Data (recommended) — Free tier gives 800 API calls/day
# Sign up at https://twelvedata.com
TWELVE_DATA_API_KEY=

# Finnhub (alternative) — Free tier with forex data
# Sign up at https://finnhub.io
FINNHUB_API_KEY=
